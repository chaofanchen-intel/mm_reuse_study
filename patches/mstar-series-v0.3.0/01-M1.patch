index 000000000..d85843958
--- /dev/null
+++ b/mstar/model/components/encoder_output_cache.py
@@ -0,0 +1,149 @@
+"""Per-item encoder-output cache for packed vision encoders (mm_reuse_study prototype M1).
+
+Opt-in: ``MSTAR_ENCODER_CACHE_MB`` > 0 enables it with that byte cap (LRU).
+``MSTAR_ENCODER_CACHE_LOG`` (a path) appends one line per prepared request, with the
+cache on or off:
+``time  request_id  items  hits  encoded``.
+
+Key: xxh3-128 of each item's pixel bytes, plus its grid, dtype and patch shape.
+The pixel tensor is what preprocessing produced, so resize and normalisation are
+covered. 128-bit non-cryptographic: fine for a study, not for adversarial input.
+
+When every item of a row hits, the submodule hands the assembled outputs to the
+engine (``pop_served_outputs``); the engine marks the row as served by the cache,
+runs no forward for it, and routes these outputs (mstar/engine/engine.py, "M1").
+"""
+from __future__ import annotations
+
+import os
+import time
+from collections import OrderedDict
+from dataclasses import dataclass
+
+import torch
+import xxhash
+
+CACHE_MB = float(os.environ.get("MSTAR_ENCODER_CACHE_MB", "0") or 0)
+# Entries live in pinned host memory: the engine's planner fills the GPU with KV pages and
+# graphs and knows nothing of this cache (a 2 GB device cache OOMed rank 0 on 5880).
+# A hit copies back to the device (~5 MB per 640x480 frame for Qwen3-Omni).
+LOG_PATH = os.environ.get("MSTAR_ENCODER_CACHE_LOG")
+
+
+@dataclass
+class ItemPlan:
+    keys: list[tuple]                       # per item, in prompt order
+    tokens: list[int]                       # merged rows per item
+    cached: list[list[torch.Tensor] | None]  # per item: [embeds, *deepstack] when served from cache
+    encode: list[int]                       # item indices encoded this step, in order
+    ids: tuple = ()                         # every key the plan is stored under
+
+
+class EncoderOutputCache:
+    def __init__(self, cap_mb: float = CACHE_MB):
+        self.cap = int(cap_mb * 2 ** 20)
+        self.device = torch.device("cpu")   # set from the first fresh outputs
+        self.size = 0
+        self.store: OrderedDict[tuple, list[torch.Tensor]] = OrderedDict()
+        self.plans: dict[str, ItemPlan] = {}
+        self.served: dict = {}   # row id -> [embeds, *deepstack], all items from cache
+
+    @property
+    def enabled(self) -> bool:
+        return self.cap > 0
+
+    @staticmethod
+    def key(pixels: torch.Tensor, grid: tuple[int, int, int], extra: tuple = ()) -> tuple:
+        flat = pixels.detach().contiguous()
+        if flat.device.type != "cpu":
+            flat = flat.cpu()
+        digest = xxhash.xxh3_128_hexdigest(flat.view(torch.uint8).numpy().tobytes())
+        return digest, grid, str(pixels.dtype), tuple(pixels.shape[1:]), *extra
+
+    @torch.compiler.disable   # called from compiled forwards (BAGEL's ViT); host-side bookkeeping
+    def plan(self, rid: str | tuple, pixels: list[torch.Tensor], grids: list[tuple[int, int, int]], merge: int,
+             extra: tuple = ()) -> ItemPlan:
+        keys = [self.key(p, g, extra) for p, g in zip(pixels, grids, strict=True)]
+        cached = []
+        for k in keys:
+            hit = self.store.get(k)
+            if hit is not None:
+                self.store.move_to_end(k)
+                hit = [t.to(self.device, non_blocking=True) for t in hit]
+            cached.append(hit)
+        encode = [i for i, c in enumerate(cached) if c is None]
+        ids = rid if isinstance(rid, tuple) else (rid,)
+        plan = ItemPlan(keys, [t * h * w // merge ** 2 for t, h, w in grids], cached, encode, ids)
+        if not encode:   # every item cached: serve the row without a forward
+            full = per_item_cat([c for c in cached])
+            for i in ids:
+                self.served[i] = (full, ids)
+        else:
+            for i in ids:   # the engine may name the row by wire id or by worker handle
+                self.plans[i] = plan
+        if LOG_PATH:
+            hits = sum(c is not None for c in cached)
+            with open(LOG_PATH, "a") as f:
+                f.write(f"{time.time():.6f}\t{ids[0]}\t{len(keys)}\t{hits}\t{len(encode)}\n")
+        return plan
+
+    @staticmethod
+    def debug(msg: str) -> None:
+        if LOG_PATH:
+            with open(LOG_PATH + ".debug", "a") as f:
+                f.write(f"{time.time():.6f}\t{msg}\n")
+
+    @staticmethod
+    def log_uncached(rid, items: int) -> None:
+        """Cache off: still log the request's item count (all encoded), so a baseline is measured alike."""
+        if LOG_PATH:
+            with open(LOG_PATH, "a") as f:
+                f.write(f"{time.time():.6f}\t{rid}\t{items}\t0\t{items}\n")
+
+    def _put(self, key: tuple, tensors: list[torch.Tensor]) -> None:
+        if key in self.store:
+            return
+        nbytes = sum(t.numel() * t.element_size() for t in tensors)
+        if nbytes > self.cap:
+            return
+        self.store[key] = tensors
+        self.size += nbytes
+        while self.size > self.cap:
+            _, old = self.store.popitem(last=False)
+            self.size -= sum(t.numel() * t.element_size() for t in old)
+
+    @torch.compiler.disable   # called from compiled forwards (BAGEL's ViT); host-side bookkeeping
+    def pop_served(self, rid) -> list[torch.Tensor] | None:
+        entry = self.served.get(rid)
+        if entry is None:
+            return None
+        full, ids = entry
+        for i in ids:
+            self.served.pop(i, None)
+        return full
+
+    @torch.compiler.disable   # called from compiled forwards (BAGEL's ViT); host-side bookkeeping
+    def assemble(self, rid: str, fresh: list[torch.Tensor]) -> list[torch.Tensor]:
+        """``fresh``: [embeds, *deepstack] for the encoded items of ``rid``, packed in
+        ``plan.encode`` order. Returns the same list for all items in prompt order,
+        and stores the fresh items."""
+        plan = self.plans[rid]
+        for i in plan.ids:
+            self.plans.pop(i, None)
+        per_item: list[list[torch.Tensor] | None] = list(plan.cached)
+        start = 0
+        self.device = fresh[0].device
+        for i in plan.encode:
+            n = plan.tokens[i]
+            item = [t[start:start + n] for t in fresh]
+            per_item[i] = item
+            self._put(plan.keys[i], [t.to("cpu").pin_memory() if t.is_cuda else t.clone() for t in item])
+            start += n
+        assert start == fresh[0].shape[0], (start, fresh[0].shape)
+        return per_item_cat(per_item)
+
+
+def per_item_cat(per_item: list[list[torch.Tensor]]) -> list[torch.Tensor]:
+    if len(per_item) == 1:
+        return per_item[0]
+    return [torch.cat([item[j] for item in per_item]) for j in range(len(per_item[0]))]
