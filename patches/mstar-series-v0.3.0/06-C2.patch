+    def _vision_ahead_plan(self, input_modalities: list[str], audio_output: bool) -> list[WalkStep]:
+        """mm_reuse_study C2: one encode-only step per image group, in prompt order. Image-only prompts
+        with text out."""
+        if audio_output or not set(input_modalities) <= {TEXT, "image"}:
+            return []
+        plan = []
+        steps = _thinker_steps(prefill_plan(parts_from_modalities(input_modalities)))
+        groups = [[p.index for p in step.parts if p.modality == "image"] for step in steps]
+        # group 0 too: the worker may schedule this partition's first step before the Thinker's first
+        # encode, and whichever runs second takes the group from the cache
+        for images in [g for g in groups if g]:
+            bind = {name: span_name(key, images[0]) for name, key in self._MM_WALKS["image"][1].items()}
+            plan.append(WalkStep(VISION_AHEAD, bind=bind, step_metadata={
+                c1_registry.FIRST: images[0], c1_registry.COUNT: len(images)}))
+        return plan
+
     @staticmethod
     def _decode_walk(audio_output: bool) -> str:
         return "thinker_decode" if audio_output else THINKER_TEXT_DECODE
@@ -1492,7 +1523,7 @@ class Qwen3OmniModel(Model):
             return self._create_code2wav_submodule(device)
         elif node_name == "audio_encoder":
             return self._create_audio_encoder_submodule(device, autocast_dtype)
-        elif node_name == "vision_encoder":
+        elif node_name in ("vision_encoder", VISION_AHEAD):
             return self._create_vision_encoder_submodule(device, autocast_dtype)
         return None
 
