+# mm_reuse_study M3: consecutive images with no text between them prefill in one walk
+# (one vision-encoder call and one Thinker row), instead of a walk pair per image.
+# MSTAR_GROUP_IMAGES=N: at most N images per group (unset/0/1: a walk pair per image, as upstream).
+# Kept small: a long grouped row (8 images, ~2400 tokens) lost its prefix hits and diverged the TP ranks.
+GROUP_IMAGES = int(os.environ.get("MSTAR_GROUP_IMAGES", "0") or 0)
+
+
+
+def _media_groups(plan: list[PromptPart], media: list[int]) -> list[list[int]]:
+    """The attachments, each its own group, or with ``GROUP_IMAGES`` each run of
+    adjacent images (plan neighbours, so no text between them) as one group."""
+    groups: list[list[int]] = []
+    for at in media:
+        if (
+            GROUP_IMAGES > 1 and groups and len(groups[-1]) < GROUP_IMAGES and plan[at].modality == "image"
+            and plan[groups[-1][-1]].modality == "image" and groups[-1][-1] == at - 1
+        ):
+            groups[-1].append(at)
+        else:
+            groups.append([at])
+    return groups
+
+
 class ImageSpan(NamedTuple):
