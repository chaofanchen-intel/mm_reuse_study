diff --git a/mstar/model/components/c1_registry.py b/mstar/model/components/c1_registry.py
new file mode 100644
index 000000000..4959a395d
--- /dev/null
+++ b/mstar/model/components/c1_registry.py
@@ -0,0 +1,47 @@
+"""mm_reuse_study C1: skip encoding the images a request's Thinker prefix lease already holds.
+
+MSTAR_C1=1. The model splits the prompt's leading text into its own Thinker step, so the Thinker's
+rank 0 takes the request's prefix lease (`Engine.decide_cached_prefix`) before any image is encoded.
+It then writes here how many of the request's leading images lie wholly inside the lease. Each
+image step's vision encoder reads that count and encodes (or serves from the M1 cache) only the
+images past it; the Thinker pads the skipped rows with zeros, which its prefix hit never reads
+(`ThinkerSubmodule._c1_pad`), and the engine fails the row if the hit ends short of them.
+
+The lease holds its pages until the request's steps admit, so the count stays true for the
+request's later steps. The channel is a file per request under /dev/shm, a prototype: a
+runtime would carry the count on the Thinker's step report to the conductor.
+"""
+import os
+
+ENABLED = os.environ.get("MSTAR_C1", "0") == "1"
+DIR = os.environ.get("MSTAR_C1_DIR", "/dev/shm/mstar_c1")
+# step_metadata of an image step: the index of its first image among the request's images, and how many
+FIRST = "c1_first"
+COUNT = "c1_count"
+
+
+def _path(request_id: str) -> str:
+    return os.path.join(DIR, str(request_id).replace("/", "_"))
+
+
+def write(request_id: str, covered: int) -> None:
+    os.makedirs(DIR, exist_ok=True)
+    tmp = _path(request_id) + ".tmp"
+    with open(tmp, "w") as f:
+        f.write(str(covered))
+    os.replace(tmp, _path(request_id))
+
+
+def read(request_id: str) -> int:
+    try:
+        with open(_path(request_id)) as f:
+            return int(f.read() or 0)
+    except (OSError, ValueError):
+        return 0
+
+
+def drop(request_id: str) -> None:
+    try:
+        os.unlink(_path(request_id))
+    except OSError:
+        pass
diff --git a/mstar/model/components/encoder_output_cache.py b/mstar/model/components/encoder_output_cache.py
new file mode 100644
index 000000000..9a7b46d23
--- /dev/null
+++ b/mstar/model/components/encoder_output_cache.py
@@ -0,0 +1,176 @@
+"""Per-item encoder-output cache for packed vision encoders (mm_reuse_study prototype M1).
+
+Opt-in: ``MSTAR_ENCODER_CACHE_MB`` > 0 enables it with that byte cap (LRU).
+``MSTAR_ENCODER_CACHE_LOG`` (a path) appends one line per prepared request, with the
+cache on or off:
+``time  request_id  items  hits  encoded``.
+
+Key: xxh3-128 of each item's pixel bytes, plus its grid, dtype and patch shape.
+The pixel tensor is what preprocessing produced, so resize and normalisation are
+covered. 128-bit non-cryptographic: fine for a study, not for adversarial input.
+
+When every item of a row hits, the submodule hands the assembled outputs to the
+engine (``pop_served_outputs``); the engine marks the row as served by the cache,
+runs no forward for it, and routes these outputs (mstar/engine/engine.py, "M1").
+"""
+from __future__ import annotations
+
+import os
+import time
+from collections import OrderedDict
+from dataclasses import dataclass
+
+import torch
+import xxhash
+
+CACHE_MB = float(os.environ.get("MSTAR_ENCODER_CACHE_MB", "0") or 0)
+# Entries live in pinned host memory: the engine's planner fills the GPU with KV pages and
+# graphs and knows nothing of this cache (a 2 GB device cache OOMed rank 0 on 5880).
+# A hit copies back to the device (~5 MB per 640x480 frame for Qwen3-Omni).
+LOG_PATH = os.environ.get("MSTAR_ENCODER_CACHE_LOG")
+
+
+@dataclass
+class ItemPlan:
+    keys: list[tuple]                       # per item, in prompt order
+    tokens: list[int]                       # merged rows per item
+    cached: list[list[torch.Tensor] | None]  # per item: [embeds, *deepstack] when served from cache
+    encode: list[int]                       # item indices encoded this step, in order
+    ids: tuple = ()                         # every key the plan is stored under
+
+
+class EncoderOutputCache:
+    def __init__(self, cap_mb: float = CACHE_MB):
+        self.cap = int(cap_mb * 2 ** 20)
+        self.device = torch.device("cpu")   # set from the first fresh outputs
+        # store and its byte count, shareable between two encoder nodes of one process (C2: `share`)
+        self._shared = {"size": 0, "store": OrderedDict()}
+        self.plans: dict[str, ItemPlan] = {}
+        self.served: dict = {}   # row id -> [embeds, *deepstack], all items from cache
+
+    @property
+    def enabled(self) -> bool:
+        return self.cap > 0
+
+    @property
+    def store(self) -> OrderedDict:
+        return self._shared["store"]
+
+    @property
+    def size(self) -> int:
+        return self._shared["size"]
+
+    @size.setter
+    def size(self, n: int) -> None:
+        self._shared["size"] = n
+
+    def share(self, other: "EncoderOutputCache") -> None:
+        """mm_reuse_study C2: use ``other``'s entries (another node's cache in this process)."""
+        self._shared = other._shared
+
+    def keys_for(self, pixels, grids, extra: tuple = (), digests: list | None = None) -> list[tuple]:
+        if digests is not None:
+            return [("given", d, g, str(p.dtype), tuple(p.shape[1:]), *extra)
+                    for d, p, g in zip(digests, pixels, grids, strict=True)]
+        return [self.key(p, g, extra) for p, g in zip(pixels, grids, strict=True)]
+
+    @staticmethod
+    def key(pixels: torch.Tensor, grid: tuple[int, int, int], extra: tuple = ()) -> tuple:
+        flat = pixels.detach().contiguous()
+        if flat.device.type != "cpu":
+            flat = flat.cpu()
+        digest = xxhash.xxh3_128_hexdigest(flat.view(torch.uint8).numpy().tobytes())
+        return digest, grid, str(pixels.dtype), tuple(pixels.shape[1:]), *extra
+
+    @torch.compiler.disable   # called from compiled forwards (BAGEL's ViT); host-side bookkeeping
+    def plan(self, rid: str | tuple, pixels: list[torch.Tensor], grids: list[tuple[int, int, int]], merge: int,
+             extra: tuple = (), digests: list | None = None) -> ItemPlan:
+        """``digests``: per item, a key the caller already has (M4: the data worker's), used
+        instead of hashing the pixels; it is paired with the grid, dtype and patch shape all the same."""
+        _t0 = time.perf_counter()
+        keys = self.keys_for(pixels, grids, extra, digests)
+        _t1 = time.perf_counter()
+        cached = []
+        for k in keys:
+            hit = self.store.get(k)
+            if hit is not None:
+                self.store.move_to_end(k)
+                hit = [t.to(self.device, non_blocking=True) for t in hit]
+            cached.append(hit)
