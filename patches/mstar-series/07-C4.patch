+def _c4_original(path: str) -> str:
+    """mm_reuse_study C4: a frame reference keys its KV as the frame it names (the model saved that frame's
+    bytes under ``MSTAR_C4_FRAMES_DIR`` when it first loaded them), so a frame sent in full and as a
+    reference share their prefix pages."""
+    if _C4_FRAMES_DIR is None:
+        return path
+    with open(path, "rb") as f:
+        head = f.read(64)
+    if not head.startswith(b"MSTAR-FRAME:"):
+        return path
+    return os.path.join(_C4_FRAMES_DIR, head[len(b"MSTAR-FRAME:"):].decode().strip())
 
