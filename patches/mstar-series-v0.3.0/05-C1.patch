+    def c1_covered_items(self, rid: str, node_name: str, graph_walk: str) -> int:
+        """mm_reuse_study C1: how many of the stream's leading item (digest) spans lie wholly inside its
+        lease, counting until the first that doesn't."""
+        with self._lock:
+            label = self._keyed_label(rid, node_name, graph_walk)
+            stream = None if label is None else self._streams.get(rid, {}).get(label)
+            if stream is None or stream.chain is None or stream.lease is None:
+                return 0
+            held, at, n = stream.lease_len, 0, 0
+            for span in stream.chain.spans:
+                at += span.length
+                if span.digest is None:
+                    continue
+                if at > held:
+                    break
+                n += 1
+            return n
+
