+        ids = rid if isinstance(rid, tuple) else (rid,)
+        plan = ItemPlan(keys, [t * h * w // merge ** 2 for t, h, w in grids], cached, encode, ids)
+        if not encode:   # every item cached: serve the row without a forward
+            full = per_item_cat([c for c in cached])
+            for i in ids:
+                self.served[i] = (full, ids)
+        else:
+            for i in ids:   # the engine may name the row by wire id or by worker handle
+                self.plans[i] = plan
+        if LOG_PATH:
+            hits = sum(c is not None for c in cached)
+            with open(LOG_PATH, "a") as f:
+                f.write(f"{time.time():.6f}\t{ids[0]}\t{len(keys)}\t{hits}\t{len(encode)}"
+                        f"\tkey_ms={(_t1 - _t0) * 1000:.1f}\tplan_ms={(time.perf_counter() - _t0) * 1000:.1f}\n")
+        return plan
+
+    @staticmethod
+    def debug(msg: str) -> None:
+        if LOG_PATH:
+            with open(LOG_PATH + ".debug", "a") as f:
+                f.write(f"{time.time():.6f}\t{msg}\n")
+
+    @staticmethod
+    def log_uncached(rid, items: int) -> None:
+        """Cache off: still log the request's item count (all encoded), so a baseline is measured alike."""
+        if LOG_PATH:
+            with open(LOG_PATH, "a") as f:
+                f.write(f"{time.time():.6f}\t{rid}\t{items}\t0\t{items}\n")
+
+    def _put(self, key: tuple, tensors: list[torch.Tensor]) -> None:
+        if key in self.store:
+            return
+        nbytes = sum(t.numel() * t.element_size() for t in tensors)
+        if nbytes > self.cap:
+            return
+        self.store[key] = tensors
+        self.size += nbytes
+        while self.size > self.cap:
+            _, old = self.store.popitem(last=False)
+            self.size -= sum(t.numel() * t.element_size() for t in old)
+
+    @torch.compiler.disable   # called from compiled forwards (BAGEL's ViT); host-side bookkeeping
+    def pop_served(self, rid) -> list[torch.Tensor] | None:
+        entry = self.served.get(rid)
+        if entry is None:
+            return None
+        full, ids = entry
+        for i in ids:
+            self.served.pop(i, None)
+        return full
+
+    @torch.compiler.disable   # called from compiled forwards (BAGEL's ViT); host-side bookkeeping
+    def assemble(self, rid: str, fresh: list[torch.Tensor]) -> list[torch.Tensor]:
+        """``fresh``: [embeds, *deepstack] for the encoded items of ``rid``, packed in
+        ``plan.encode`` order. Returns the same list for all items in prompt order,
+        and stores the fresh items."""
+        plan = self.plans[rid]
+        for i in plan.ids:
+            self.plans.pop(i, None)
+        per_item: list[list[torch.Tensor] | None] = list(plan.cached)
+        start = 0
+        self.device = fresh[0].device
+        for i in plan.encode:
+            n = plan.tokens[i]
+            item = [t[start:start + n] for t in fresh]
+            per_item[i] = item
+            self._put(plan.keys[i], [t.to("cpu").pin_memory() if t.is_cuda else t.clone() for t in item])
+            start += n
+        assert start == fresh[0].shape[0], (start, fresh[0].shape)
+        return per_item_cat(per_item)
+
+
+def per_item_cat(per_item: list[list[torch.Tensor]]) -> list[torch.Tensor]:
+    if len(per_item) == 1:
+        return per_item[0]
+    return [torch.cat([item[j] for item in per_item]) for j in range(len(per_item[0]))]
