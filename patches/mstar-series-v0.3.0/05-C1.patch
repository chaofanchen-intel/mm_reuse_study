+    def _c1_pad(self, inputs: NameToTensorList, device) -> tuple[NameToTensorList, int]:
+        """mm_reuse_study C1: the encoder skipped the step's leading images the prefix lease holds, so
+        its outputs lack their rows. Puts zeros in their place, which the prefix hit never reads
+        (`_c1_check` in the engine), and returns how many images were skipped."""
+        merge = self.config.vision.spatial_merge_size
+        counts = [int(g.prod()) // merge ** 2 for g in inputs["image_grid_thw"][0].reshape(-1, 3)]
+        embeds = inputs["vision_embeds"][0]
+        missing = sum(counts) - embeds.shape[0]
+        if missing <= 0:
+            return inputs, 0
+        skipped, acc = 0, 0
+        while acc < missing:
+            acc += counts[skipped]
+            skipped += 1
+        assert acc == missing, (counts, embeds.shape)
+
+        def padded(t):
+            t = t.to(device)
+            return torch.cat([torch.zeros(missing, *t.shape[1:], dtype=t.dtype, device=device), t])
+        return {**inputs, "vision_embeds": [padded(embeds)],
+                "deepstack": [padded(t) for t in inputs["deepstack"]]}, skipped
