+    def _grouped_image_row(
+        self, fwd_info: CurrentForwardPassInfo, inputs: NameToTensorList, start_pos: int,
+    ) -> ARNodeInputs:
+        """mm_reuse_study M3: several images in one row, each laid out as a
+        single-image row lays it out (sentinels, grid positions, the advance
+        ``image_span`` gives), one after the other, so positions and KV equal
+        those of the walk-per-image plan."""
+        device = self.get_device()
+        merge = self.config.vision.spatial_merge_size
+        before, after = self._text_around(fwd_info, inputs)
+        vision_embeds = inputs["vision_embeds"][0].to(device)
+        grids = inputs["image_grid_thw"][0].reshape(-1, 3)
+        counts = [int(g.prod()) // merge ** 2 for g in grids]
+        assert sum(counts) == vision_embeds.shape[0], (counts, vision_embeds.shape)
+        media_pos = start_pos + before.shape[0]
+        pos = media_pos
+        embeds, pos_ids, offsets = [], [], []
+        row_start = 0
+        at = before.shape[0]   # row offset of the current image's BOS within the spliced row
+        for grid, n in zip(grids, counts):
+            emb = vision_embeds[row_start:row_start + n]
+            embeds.append(self._wrap_vision_input(emb))
+            vis = get_rope_index_vision(
+                grid.to(device), pos + 1, position_id_per_seconds=self.config.thinker.position_id_per_seconds,
+                device=device, spatial_merge_size=merge, seconds_per_grid=None,
+            )
+            end_base = pos + image_span(grid, merge).advance - 1
+            pos_ids.append(torch.cat([get_rope_index_text(1, pos, device), vis,
+                                      get_rope_index_text(1, end_base, device)], dim=1))
+            offsets.append((at + 1, row_start, n))
+            at += n + 2
+            row_start += n
+            pos = end_base + 1
+        total = sum(counts) + 2 * len(counts)
+        mm_mask = None
+        if fwd_info.step_metadata.get("audio_output", True):
+            mm_mask = torch.ones(total, dtype=torch.bool, device=device)
+            for row_at, _, n in offsets:
+                mm_mask[row_at - 1 - before.shape[0]].fill_(False)
+                mm_mask[row_at + n - before.shape[0]].fill_(False)
+        row = self._spliced_row(
+            before, after, torch.cat(embeds), torch.cat(pos_ids, dim=1), mm_mask, start_pos, int(pos - media_pos),
+        )
+        deepstack = []
+        for deepstack_inp in inputs["deepstack"]:
+            full = torch.zeros_like(row.input_embeds)
+            for row_at, src, n in offsets:
+                full[row_at:row_at + n] = deepstack_inp[src:src + n]
+            deepstack.append(full)
+        row.tensor_inputs["deepstack"] = deepstack
+        return row
+
