@@ -229,6 +231,51 @@ def _thinker_steps(plan: list[PromptPart]) -> list[ThinkerStep]:
 GROUP_IMAGES = int(os.environ.get("MSTAR_GROUP_IMAGES", "0") or 0)
 
 
+class _PreprocessCache:
+    """mm_reuse_study M3b: the image processor's output per decoded image, keyed by
+    xxh3-128 of its pixels, shape and dtype plus the processor class (LRU, host
+    memory, ``MSTAR_PREPROCESS_CACHE_MB``; 0 = off). vLLM's processor cache plays
+    this part there. A 640x480 frame: 7.5 ms of processing against 0.05 ms of hashing."""
+
+    def __init__(self, cap_mb: float):
+        self.cap = int(cap_mb * 2 ** 20)
+        self.size = 0
+        self.store: "OrderedDict[tuple, dict]" = OrderedDict()
+
+    @property
+    def enabled(self) -> bool:
+        return self.cap > 0
+
+    @staticmethod
+    def key(img, proc_name: str) -> tuple:
+        import numpy as np
+        import xxhash
+        arr = img.detach().cpu().contiguous().numpy() if isinstance(img, torch.Tensor) else np.asarray(img)
+        return xxhash.xxh3_128_hexdigest(arr.tobytes()), arr.shape, str(arr.dtype), proc_name
+
+    def get(self, key):
+        if key is None or key not in self.store:
+            return None
+        self.store.move_to_end(key)
+        return self.store[key]
+
+    def put(self, key, out) -> None:
+        if key is None or key in self.store:
+            return
+        n = sum(v.numel() * v.element_size() for v in out.values() if isinstance(v, torch.Tensor))
+        if n > self.cap:
+            return
+        self.store[key] = out
+        self.size += n
+        while self.size > self.cap:
+            _, old = self.store.popitem(last=False)
+            self.size -= sum(v.numel() * v.element_size() for v in old.values() if isinstance(v, torch.Tensor))
+
+
+_PP_LOG = os.environ.get("MSTAR_PREPROCESS_LOG")
+
+_PREPROCESS_CACHE = _PreprocessCache(float(os.environ.get("MSTAR_PREPROCESS_CACHE_MB", "0") or 0))
+
 
 def _media_groups(plan: list[PromptPart], media: list[int]) -> list[list[int]]:
     """The attachments, each its own group, or with ``GROUP_IMAGES`` each run of
@@ -1101,12 +1148,24 @@ class Qwen3OmniModel(Model):
 
