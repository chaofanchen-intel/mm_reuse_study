+        for step in steps:   # M3: a group's images travel as one signal, under its first image's name
+            images = [part.index for part in step.parts if part.modality == "image"]
+            if len(images) > 1:
+                first = images[0]
+                out[span_name("pixel_values", first)] = [torch.cat(
+                    [out.pop(span_name("pixel_values", i))[0] if i != first else out[span_name("pixel_values", i)][0]
